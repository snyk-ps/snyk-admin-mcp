{
  "name": "snyk-admin-mcp",
  "version": "2.1.0",
  "description": "MCP server for Snyk group admins: copy org settings, clone integrations, create orgs, tag, classify, and move projects, label assets, manage collections and ignore policies, list members and service accounts, and search audit logs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "snyk-admin-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "TOOLS.md"
  ],
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snyk-ps/snyk-admin-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "bundle": "npm run build && node scripts/build-mcpb.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "18.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
